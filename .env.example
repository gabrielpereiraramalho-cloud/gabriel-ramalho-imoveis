# ---------------------------------------------------------------------------
# Gabriel Ramalho Imóveis — variáveis de ambiente (exemplo)
# Copie este arquivo para `.env.local` e preencha com os valores reais.
# NUNCA versione o `.env.local` nem exponha o SERVICE_ROLE no frontend.
# ---------------------------------------------------------------------------

# URL pública do projeto Supabase (ex.: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (pública) do Supabase — segura para uso no browser
# Nomenclatura atual recomendada pelo Supabase (substitui a antiga anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta do Supabase (service role) — USO EXCLUSIVO NO SERVIDOR.
# Nunca prefixar com NEXT_PUBLIC_. Nunca importar em componentes de cliente.
SUPABASE_SECRET_KEY=

# URL pública do site (usada futuramente para SEO/canonical/metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp para os CTAs (somente dígitos, com DDI e DDD)
# Ex.: 5583999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Perfil do Instagram (URL completa) — exibido no rodapé se preenchido
NEXT_PUBLIC_INSTAGRAM_URL=

# E-mail de contato — exibido no rodapé se preenchido
NEXT_PUBLIC_CONTACT_EMAIL=

# Registro CRECI — exibido no rodapé e na seção Sobre se preenchido
NEXT_PUBLIC_CRECI=

# Google Analytics 4 — Measurement ID (ex.: G-XXXXXXXXXX). Vazio desabilita o GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Órulo — integração de catálogo (SERVER-SIDE apenas; nunca NEXT_PUBLIC).
# O Client Secret jamais deve ir para o browser, logs ou Git.
# ---------------------------------------------------------------------------
ORULO_CLIENT_ID=
ORULO_CLIENT_SECRET=
# Opcional: host base da API Órulo (default https://www.orulo.com.br). Confirmar.
ORULO_BASE_URL=

# Meta Pixel — Pixel ID (somente dígitos). Vazio desabilita o Pixel.
NEXT_PUBLIC_META_PIXEL_ID=
